# ============================================================
# Google Photos Discovery Engine — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# --- Environment Variables (NEVER commit secrets) ---
.env
.env.local
.env.*.local

# --- Raw Data (large, regenerable) ---
backend/data/raw/**/*.jsonl
backend/data/raw/**/*.json
!backend/data/raw/**/.gitkeep

# --- Node.js / Frontend ---
node_modules/
frontend/dist/
frontend/build/
.vite/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Database ---
*.sql.bak
*.dump

# --- Logs ---
*.log
logs/

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- OS ---
.DS_Store
Desktop.ini
ehthumbs.db

# --- Misc ---
*.bak
*.tmp
pipeline.lock
